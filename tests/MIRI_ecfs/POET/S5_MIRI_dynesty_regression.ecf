# Eureka! Control File for Stage 5: MIRI POET dynesty regression testing

# Use one process and a fixed seed so this stochastic fit has a reproducible
# regression baseline. Normal science ECFs can omit random_seed.
ncpu            1
random_seed     12345

allapers        False
rescale_err     False
fit_par         ./s5_POET.epf
verbose         True
fit_method      [dynesty]
run_myfuncs     [poet_tr,poet_ecl,poet_pc,expramp,polynomial]

# Manual clipping in time
manual_clip     None

# Limb darkening controls
use_generate_ld  None
ld_file          None
ld_file_white    None

# General fitter
old_fitparams   None

# dynesty
run_nlive       64
run_bound       'multi'
run_sample      'auto'
run_tol         10

# Plotting controls
interp          False

# Diagnostics
isplots_S5      5
testing_S5      False
testing_model   False
hide_plots      True

# Project directory
topdir          ../tests

# Directories relative to project dir
inputdir        /data/JWST-Sim/MIRI/Stage4/
outputdir       /data/JWST-Sim/MIRI/Stage5/

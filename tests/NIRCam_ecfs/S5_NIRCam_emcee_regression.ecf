# Eureka! Control File for Stage 5: NIRCam emcee regression testing

# Use one process and a fixed seed so this stochastic fit has a reproducible
# regression baseline. Normal science ECFs can omit random_seed.
ncpu            1
random_seed     12345

allapers        True

fit_par         ./S5_fit_par.epf
verbose         True
fit_method      [emcee]
run_myfuncs     [batman_tr, polynomial, GP]

# Manual clipping in time
manual_clip     [[None,1],]

# Limb darkening controls
use_generate_ld  None
ld_file          None
ld_file_white    None

# Least-squares initialization for emcee
lsq_method      'Powell'
lsq_tol         1e-6

# emcee
old_chain       None
lsq_first       True
run_nsteps      100
run_nwalkers    32
run_nburn       10

# GP inputs
kernel_inputs   ['time']
kernel_class    ['Matern32']
GP_package      'celerite'

# Plotting controls
interp          True

# Diagnostics
isplots_S5      5
testing_S5      False
testing_model   False
hide_plots      True

# Project directory
topdir          ../tests

# Directories relative to project dir
inputdir        /data/JWST-Sim/NIRCam/Stage4/
outputdir       /data/JWST-Sim/NIRCam/Stage5/
